{
  "id": "8bb0a796-a4e9-412c-9d03-6cdf58da34d5",
  "name": "basf-carlo-iftmin-profile",
  "description": "BASF IFTMIN (instruction) -> Carlo v3 SeaHouseShipment. Covers create, update, cancel, FCL, LCL and master-sub; the mapping emits one seaHouseShipment entry per IFTMIN message in the interchange.",
  "active": true,
  "configuration": [
    {
      "type": "dataProfiler",
      "sequence": 1,
      "sender": "BASF",
      "receiver": "CARLO",
      "subject": "IFTMIN",
      "inputMimeType": "application/edifact",
      "nextResource": {
        "host": "data-pipeline-host.us-e2.cloudhub.io",
        "port": "443",
        "path": "/api/v1/data-pipeline/pass-thru",
        "method": "POST"
      }
    },
    {
      "type": "dataPipeline",
      "sequence": 2,
      "inputMimeType": "application/edifact",
      "nextResource": {
        "host": "data-transformer-host.us-e2.cloudhub.io",
        "port": "443",
        "path": "/api/v1/data-transformer/transform",
        "method": "POST"
      }
    },
    {
      "type": "dataTransformer",
      "sequence": 3,
      "dwlPath": "basf/BasfIftmin.dwl",
      "inputMimeType": "application/edifact",
      "reportingContacts": "integration.support@fracht.com",
      "nextResource": {
        "host": "data-delivery-host.us-e2.cloudhub.io",
        "port": "443",
        "path": "/api/v1/data-delivery/https",
        "method": "POST"
      }
    },
    {
      "type": "dataDelivery",
      "sequence": 4,
      "host": "api-carlo-test.fracht.be",
      "port": "4712",
      "path": "/api/PolytraSeafreightHouseShipment_BASF/v3/SeaHouseShipment",
      "method": "POST",
      "mimeType": "application/json",
      "validResponseCodes": "200..299"
    }
  ]
}
